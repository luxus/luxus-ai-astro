---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const contacts = [
  { label: 'GitHub', href: 'https://github.com/luxus', display: 'github.com/luxus' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/luxus', display: 'linkedin.com/in/luxus' },
  { label: 'X', href: 'https://x.com/luxus', display: 'x.com/luxus' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Kai Löhnert — ${SITE_TITLE}.ai`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div class="shell">
      <div class="bg-grid" aria-hidden="true"></div>
      <div class="signal-line" aria-hidden="true"></div>

      <main class="page">
        <article class="tech-panel">
          <div class="status-row" aria-hidden="true">
            <div class="status-item">
              <span class="status-dot status-dot--blue"></span>
              <span>STATUS: ACTIVE</span>
            </div>
            <div class="status-rule"></div>
            <div class="status-item">
              <span class="status-dot status-dot--red"></span>
              <span>SYS: SECURE</span>
            </div>
          </div>

          <header class="page-header">
            <h1>Kai Löhnert</h1>
            <p class="handle">@luxus</p>
          </header>

          <div class="divider" aria-hidden="true"></div>

          <section class="about" aria-label="About">
            <p>
              Cybersecurity engineer. I design defenses by thinking like the people who break
              them.
            </p>
          </section>

          <nav aria-label="Links">
            <div class="nav-label">Connection Vectors</div>
            <ul class="contacts">
              {
                contacts.map((c) => (
                  <li>
                    <a
                      class="link-item"
                      href={c.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="link-label">{c.label}</span>
                      <span class="link-url">{c.display}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </article>

        <div class="meta" aria-hidden="true">
          <span>INT.01</span>
          <span class="meta-rule"></span>
          <span>ZRH.CH</span>
        </div>
      </main>
    </div>
  </body>
</html>
