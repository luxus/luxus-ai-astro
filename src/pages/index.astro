---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const contacts = [
  { label: 'GitHub', href: 'https://github.com/luxus', display: 'github.com/luxus' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/luxus', display: 'linkedin.com/in/luxus' },
  { label: 'X', href: 'https://x.com/luxus', display: 'x.com/luxus' },
];
---

<!doctype html>
<html lang="en" data-webtui-theme="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <article class="page" box-="square" is-="wrap">
        <header>
          <h1>Kai Löhnert</h1>
          <p class="handle">@{SITE_TITLE}</p>
        </header>

        <hr />

        <section class="about" aria-label="About">
          <p>
            Cybersecurity sales in Zürich, Switzerland. Half German, half Thai —
            I work at the intersection of technology and trust.
          </p>
        </section>

        <hr />

        <nav aria-label="Contact">
          <ul class="contacts">
            {
              contacts.map((c) => (
                <li>
                  <a href={c.href} target="_blank" rel="noopener noreferrer">
                    <span class="label">{c.label}</span>
                    <span class="url">{c.display}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </article>
    </main>
  </body>
</html>
